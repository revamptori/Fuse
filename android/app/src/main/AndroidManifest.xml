<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Fuss requests only what it needs:
        * READ_MEDIA_IMAGES / READ_EXTERNAL_STORAGE to show thumbnails and to
          browse folders the system exposes through legacy paths on Android 11-12.
        * No INTERNET permission at all: the app cannot phone home even if it
          wanted to.
        * No MANAGE_EXTERNAL_STORAGE: everything outside the media directories is
          reached through SAF grants the user makes deliberately.
    -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <uses-feature android:name="android.hardware.type.pc" android:required="false" />

    <!--
        Component names are written out in full on purpose. The Gradle namespace
        is `cloud.fuss`, but the classes live in `cloud.fuss.app`, so the short
        form (".MainActivity") resolves to `cloud.fuss.MainActivity` — a class
        that does not exist. The process then dies during startup and the
        launcher shows nothing but "Fuss keeps stopping".
    -->
    <application
        android:name="cloud.fuss.app.FussApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="false"
        android:requestLegacyExternalStorage="false"
        android:supportsRtl="true"
        android:theme="@style/Theme.Fuss"
        android:enableOnBackInvokedCallback="true">

        <activity
            android:name="cloud.fuss.app.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            FileProvider for opening/sharing files with other apps. Paths cover
            shared storage, the app's own files and /proc/self/fd (used by SAF
            document handles).
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
