<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        A bare Material 3 splash-less theme: the Compose tree draws everything.
        Using a DayNight parent means the system window behind Compose already
        matches light/dark, so there is no white flash on cold start.
    -->
    <style name="Theme.Fuss" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
