<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        A bare, splash-less DayNight theme: the Compose tree paints everything
        else. Inheriting from the platform DayNight theme keeps the window behind
        Compose in the right lightness and avoids the default white flash on cold
        start. `windowBackground` matches FussTheme's `background` exactly.
    -->
    <style name="Theme.Fuss" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:colorBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
